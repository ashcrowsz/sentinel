# GitHub App (Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=change-me
# put the downloaded .pem at ./secrets/sentinel.private-key.pem (gitignored)
GITHUB_PRIVATE_KEY_PATH=./secrets/sentinel.private-key.pem

# Infra (docker compose overrides these with service names)
REDIS_URL=redis://localhost:6379/0

# LLM, always through the LiteLLM proxy. SENTINEL_MODEL is an alias from deploy/litellm*.yaml
LITELLM_CONFIG=litellm.local.yaml
LITELLM_BASE_URL=http://localhost:4000
# the proxy refuses to start without a master key; compose passes it to api + worker as LITELLM_API_KEY
# generate one: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=
SENTINEL_MODEL=reviewer
# "none" skips thinking tokens on local reasoning models (gemma 4 / qwen 3): ~4 s instead of ~11 s
SENTINEL_REASONING_EFFORT=none

# Review knobs
SENTINEL_MIN_CONFIDENCE=0.6
SENTINEL_MAX_COMMENTS=8

# Repair loop budget
SENTINEL_MAX_ITERATIONS=4
SENTINEL_MAX_COST_USD=0.50

# Where LiteLLM finds LM Studio. Docker Desktop: leave unset (host.docker.internal).
# Docker Engine in WSL: the Windows host on the WSL network (ip route | awk '/default/{print $3}')
# LMSTUDIO_API_BASE=http://<that address>:1234/v1
